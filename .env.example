# -------------------------------------------------------------
# NagrikAI Environment Configuration Template
# COPY THIS FILE TO .env.local AND FILL IN THE VALUES.
# DO NOT COMMIT .env.local OR REAL SECRETS TO VERSION CONTROL.
# -------------------------------------------------------------

# Next.js Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth, PostgreSQL Database & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI & LLM Inference (Google Gemini / OpenAI compatible)
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Python FastAPI Backend / LangGraph Sentinel Engine
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
BACKEND_INTERNAL_SECRET=your-internal-service-secret-here

# Notification Services (WhatsApp / SMS / Email)
# RESEND_API_KEY=re_your_api_key_here
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
